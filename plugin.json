{
  "name": "agy",
  "displayName": "Antigravity CLI",
  "version": "1.0.0",
  "description": "Antigravity CLI (agy) sessions in the Sessions view, resumed with agy --conversation",
  "author": "Nanling",
  "license": "MIT",
  "mayoi": ">=0.20.0",
  "main": "main.ts",
  "contributes": {
    "agents": [
      {
        "id": "agy.agent",
        "name": "Antigravity",
        "app": "agy",
        "icon": "<path d=\"M5 19c3.2-9.5 5.2-14.5 7-14.5s3.8 5 7 14.5\"/><path d=\"M8.2 14.5c2.2-1.4 5.4-1.4 7.6 0\"/>",
        "tint": ["#60a5fa", "#2563eb"],
        "resume": "agy --conversation {id}"
      }
    ],
    "settings": {
      "preferFirstPrompt": {
        "type": "boolean",
        "default": true,
        "description": "Use the first user prompt as the session name instead of Antigravity's auto-generated English title"
      },
      "dataDir": {
        "type": "string",
        "default": "",
        "description": "Antigravity CLI data directory (defaults to ~/.gemini/antigravity-cli)"
      },
      "includeArchived": {
        "type": "boolean",
        "default": false,
        "description": "Include archived Antigravity conversations in Sessions"
      },
      "sqlitePath": {
        "type": "string",
        "default": "sqlite3",
        "description": "Path to the sqlite3 executable"
      }
    }
  }
}
